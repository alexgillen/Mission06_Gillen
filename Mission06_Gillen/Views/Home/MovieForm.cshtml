@{
}

@model Mission06_Gillen.Models.AddMovie

<h2>Enter the data of a new movie to add it to the library: </h2>

<form method="post">
    <input type="hidden" asp-for="MovieId" />

    <label asp-for="CategoryId">Category</label>
    <select asp-for="CategoryId">
        <option value="">Select a Category</option>
        <option value="1">Miscellaneous</option>
        <option value="3">Television</option>
        <option value="2">Drama</option>
        <option value="4">Horror/Suspense</option>
        <option value="5">Comedy</option>
        <option value="6">Family</option>
        <option value="7">Action/Adventure</option>
        <option value="8">VHS</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
    <br />

    <label asp-for="Title">Title: </label>
    <input asp-for="Title" required />
    <span asp-validation-for="Title" class="text-danger"></span>
    <br />

    <label asp-for="Year">Year: </label>
    <input asp-for="Year" required/>
    <span asp-validation-for="Year" class="text-danger"></span>
    <br />

    <label asp-for="Director">Director: </label>
    <input asp-for="Director" required/>
    <span asp-validation-for="Director" class="text-danger"></span>
    <br />

    <label asp-for="Rating">Rating: </label>
    <select asp-for="Rating" required>
        <option value="">Select Rating</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <span asp-validation-for="Rating" class="text-danger"></span>
    <br />

    <label asp-for="Edited">Edited: </label>
    <select asp-for="Edited">
        <option value="true">Yes</option>
        <option value="false">No</option>
    </select>
    <span asp-validation-for="Edited" class="text-danger"></span>
    <br />

    <label asp-for="CopiedToPlex"></label>
    <select asp-for="CopiedToPlex">
		<option value="true">Yes</option>
		<option value="false">No</option>
    </select>
    <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    <br />

    <label asp-for="LentTo">Lent To: </label>
    <input asp-for="LentTo" />
    <br />

    <label asp-for="Notes">Notes: </label>
    <textarea asp-for="Notes"></textarea>
    <br />

    <button type="submit">Submit</button>

    <div asp-validation-summary="All"></div>

</form>
